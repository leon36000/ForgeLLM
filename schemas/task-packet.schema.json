{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgellm.local/schemas/task-packet.schema.json",
  "title": "ForgeLLM Agent Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "title", "phase", "status", "charter_goals", "goal",
    "non_goals", "inputs", "outputs", "allowed_paths", "forbidden_actions",
    "acceptance_criteria", "verification_commands", "evidence_requirements", "dependencies",
    "owner_role", "reviewer_role"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^P[0-9]+-T[0-9]{2,}$"},
    "title": {"type": "string", "minLength": 5},
    "phase": {"type": "string", "pattern": "^P[0-9]+$"},
    "status": {"enum": ["draft", "ready", "in_progress", "blocked", "review", "complete", "cancelled"]},
    "charter_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "goal": {"type": "string", "minLength": 20},
    "non_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
    "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "verification_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]+-T[0-9]{2,}$"}},
    "owner_role": {"type": "string", "minLength": 3},
    "reviewer_role": {"type": "string", "minLength": 3},
    "risk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R-[0-9]{3,}$"}},
    "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"}}
  }
}
