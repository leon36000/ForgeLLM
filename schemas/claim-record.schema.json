{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgellm.local/schemas/claim-record.schema.json",
  "title": "ForgeLLM Claim Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "class",
    "status",
    "scope",
    "sources",
    "required_experiment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CLM-[0-9]{3,}$"
    },
    "statement": {
      "type": "string",
      "minLength": 20
    },
    "class": {
      "enum": [
        "fact",
        "inference",
        "hypothesis",
        "decision",
        "measurement"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "externally_supported",
        "reproduction_planned",
        "partially_reproduced",
        "reproduced",
        "refuted",
        "inconclusive",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 3
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(REP|PAP|OFF|ADR)-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "required_experiment": {
      "type": "string",
      "minLength": 10
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CLM-[0-9]{3,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reproduced"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "class": {
            "enum": [
              "fact",
              "measurement"
            ]
          }
        }
      }
    }
  ]
}
