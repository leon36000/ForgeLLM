{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgellm.local/schemas/benchmark-result.schema.json",
  "title": "ForgeLLM Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "claim_ids", "status", "timestamps", "people",
    "source", "hardware", "software", "model", "workload", "correctness",
    "measurements", "artifacts", "conclusion", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"},
    "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"}},
    "status": {"enum": ["valid", "invalid", "inconclusive", "superseded"]},
    "timestamps": {
      "type": "object", "additionalProperties": false, "required": ["started_at", "ended_at"],
      "properties": {"started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"}}
    },
    "people": {
      "type": "object", "additionalProperties": false, "required": ["operator", "reviewer"],
      "properties": {
        "operator": {"$ref": "#/$defs/person"},
        "reviewer": {
          "type": "object", "additionalProperties": false, "required": ["id", "role", "status"],
          "properties": {"id": {"type": "string", "minLength": 2}, "role": {"type": "string", "minLength": 3}, "status": {"enum": ["pending", "approved", "rejected"]}}
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "baseline_commit", "candidate_commit", "baseline_clean", "candidate_clean"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "baseline_clean": {"type": "boolean"},
        "candidate_clean": {"type": "boolean"}
      }
    },
    "hardware": {"$ref": "#/$defs/manifestRef"},
    "software": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest", "command", "environment"],
      "properties": {
        "manifest": {"$ref": "#/$defs/manifestRef"},
        "command": {"type": "string", "minLength": 3},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "tokenizer_revision", "dtype", "quantization", "weight_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "revision": {"type": "string", "minLength": 7},
        "tokenizer_revision": {"type": "string", "minLength": 3},
        "dtype": {"type": "string", "minLength": 2},
        "quantization": {"type": ["string", "null"]},
        "weight_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest", "prompt_tokens", "output_tokens", "concurrency", "repetitions", "warmup_repetitions", "cache_state", "seeds"],
      "properties": {
        "manifest": {"$ref": "#/$defs/manifestRef"},
        "prompt_tokens": {"type": "object", "additionalProperties": false, "required": ["distribution", "values"], "properties": {"distribution": {"enum": ["fixed", "trace", "generated"]}, "values": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}}},
        "output_tokens": {"type": "object", "additionalProperties": false, "required": ["distribution", "values"], "properties": {"distribution": {"enum": ["fixed", "trace", "generated"]}, "values": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}}},
        "concurrency": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 5},
        "warmup_repetitions": {"type": "integer", "minimum": 1},
        "cache_state": {"enum": ["cold", "warm", "mixed"]},
        "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}}
      }
    },
    "correctness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "oracle", "metrics", "artifact"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run"]},
        "oracle": {"type": "string", "minLength": 3},
        "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "artifact": {"$ref": "#/$defs/manifestRef"}
      }
    },
    "measurements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric", "unit", "direction", "baseline_samples", "candidate_samples", "baseline_summary", "candidate_summary"],
        "properties": {
          "metric": {"type": "string", "minLength": 2},
          "unit": {"type": "string", "minLength": 1},
          "direction": {"enum": ["higher_is_better", "lower_is_better", "target"]},
          "baseline_samples": {"type": "array", "minItems": 5, "items": {"type": "number"}},
          "candidate_samples": {"type": "array", "minItems": 5, "items": {"type": "number"}},
          "baseline_summary": {"$ref": "#/$defs/summary"},
          "candidate_summary": {"$ref": "#/$defs/summary"}
        }
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "conclusion": {
      "type": "object", "additionalProperties": false, "required": ["scope", "effect", "limitations"],
      "properties": {"scope": {"type": "string", "minLength": 20}, "effect": {"type": "string", "minLength": 10}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["generated_by", "generated_at"],
      "properties": {"generated_by": {"type": "string", "minLength": 2}, "generated_at": {"type": "string", "format": "date-time"}}
    }
  },
  "$defs": {
    "person": {"type": "object", "additionalProperties": false, "required": ["id", "role"], "properties": {"id": {"type": "string", "minLength": 2}, "role": {"type": "string", "minLength": 3}}},
    "manifestRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "kind"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "kind": {"enum": ["raw_samples", "log", "inventory", "software_manifest", "model_manifest", "workload_manifest", "correctness", "profile", "trace", "report", "other"]}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["count", "mean", "median", "stdev", "min", "max", "p95"], "properties": {"count": {"type": "integer", "minimum": 5}, "mean": {"type": "number"}, "median": {"type": "number"}, "stdev": {"type": "number", "minimum": 0}, "min": {"type": "number"}, "max": {"type": "number"}, "p95": {"type": "number"}}}
  }
}
